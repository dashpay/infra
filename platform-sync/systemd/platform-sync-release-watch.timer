[Unit]
Description=Every two minutes: tend Platform releases that are under way (new ones arrive by a wake; the feed is read every 15 min regardless)
Documentation=https://github.com/dashpay/infra/tree/master/platform-sync

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=10s

[Install]
WantedBy=timers.target
