[Unit]
Description=Dash Platform sync: replay new dev and rc releases
Documentation=https://github.com/dashpay/infra/tree/master/platform-sync
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/platform-sync
ConditionPathIsMountPoint=/srv/platform-sync

[Service]
Type=oneshot
User=root
# Started by a wake (the .path unit) or by the timer. GitHub sends three
# deliveries for one release within a second: wait for them, then take the wake
# off the listener's spool ("+": outside this unit's read-only view) and look once.
# Whether there was a wake to take is left in a marker, which the pass reads: it
# decides whether GitHub's feed is read now.
ExecStartPre=/usr/bin/sleep 3
ExecStartPre=+/bin/sh -c 'if [ -e /run/infraclaw-wake/platform-release/wake ]; then rm -f /run/infraclaw-wake/platform-release/wake; touch /run/platform-sync-release-watch.woken; else rm -f /run/platform-sync-release-watch.woken; fi'
ExecStart=/usr/bin/python3 -u /opt/platform-sync/release_watch.py tick
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# It writes its own state and request files, nothing else. It has no Docker access of its own.
ProtectSystem=strict
ReadWritePaths=/srv/platform-sync/state /srv/platform-sync/spool/requests
